<?xml version="1.0" encoding="utf-8"?>
<!-- D6: a sessão (SharedPreferences do multiplatform-settings) não vai para o backup na nuvem nem para
     outro aparelho. Depois de restaurar, a pessoa entra de novo com o código por SMS. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="br.com.sportconnect.app_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="br.com.sportconnect.app_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
